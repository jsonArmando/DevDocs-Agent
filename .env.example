# Copia este archivo a .env y completa SOLO lo que uses. Nunca subas .env al repositorio.

# ---------------------------------------------------------------- LLM
# anthropic | openai | groq | ollama   (ollama = 100 % local, costo de API cero)
LLM_PROVIDER=anthropic
# Modelo rápido/barato: router, grader en lote, rewriter, planner de búsqueda y juez de evaluación
LLM_MODEL_FAST=claude-haiku-5-5
# Modelo de redacción: generator y síntesis de investigación
LLM_MODEL_SMART=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=            # si LLM_PROVIDER=openai   (p. ej. gpt-4o-mini / gpt-4o)
# GROQ_API_KEY=              # si LLM_PROVIDER=groq
# Modo local:  LLM_PROVIDER=ollama  LLM_MODEL_FAST=qwen2.5:7b  LLM_MODEL_SMART=qwen2.5:7b
OLLAMA_BASE_URL=http://ollama:11434

# Precios USD por millón de tokens para estimar costo por consulta (ajusta a tu proveedor)
PRICE_FAST_IN=1.0
PRICE_FAST_OUT=5.0
PRICE_SMART_IN=3.0
PRICE_SMART_OUT=15.0

# ---------------------------------------------------------------- Recuperación (valores por defecto recomendados)
RETRIEVAL_MODE=hybrid
RERANK_ENABLED=true
TOP_K=12
TOP_N=5
MAX_REWRITES=2

# ---------------------------------------------------------------- Investigación externa
# duckduckgo (gratis, sin key) | tavily (requiere TAVILY_API_KEY)
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SEARCH_TIMEOUT_S=8

# ---------------------------------------------------------------- Observabilidad opcional (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
